<% content_for :title, @document.title %>

<div class="mb-6 flex items-start justify-between gap-4">
  <h1 class="text-2xl font-semibold"><%= @document.title %></h1>
  <div class="flex shrink-0 gap-2 text-sm">
    <%= link_to "Изменить", edit_document_path(@document), class: "rounded border border-gray-300 px-3 py-1.5 hover:bg-gray-100" %>
    <%= button_to "Удалить", @document, method: :delete, form: { data: { turbo_confirm: "Удалить документ?" } },
          class: "rounded border border-red-300 px-3 py-1.5 text-red-700 hover:bg-red-50" %>
  </div>
</div>

<dl class="mb-6 grid grid-cols-2 gap-x-6 gap-y-2 text-sm sm:grid-cols-4">
  <div><dt class="text-gray-500">Тип</dt><dd><%= @document.kind %></dd></div>
  <div><dt class="text-gray-500">Тема</dt><dd><%= @document.topic %></dd></div>
  <div><dt class="text-gray-500">Язык</dt><dd><%= @document.language %></dd></div>
  <div><dt class="text-gray-500">Статус</dt><dd><%= @document.status %></dd></div>
  <div><dt class="text-gray-500">Исходный формат</dt><dd><%= @document.source_format %></dd></div>
  <div><dt class="text-gray-500">Символов</dt><dd><%= number_with_delimiter(@document.body.size, delimiter: " ") %></dd></div>
  <% if @document.source_url %>
    <div class="col-span-2"><dt class="text-gray-500">Источник</dt><dd class="truncate"><%= link_to @document.source_url, @document.source_url, class: "text-blue-700 hover:underline" %></dd></div>
  <% end %>
</dl>

<% cards = @document.cards.to_a %>
<div id="cards" class="mb-2 flex items-center justify-between">
  <h2 class="text-sm font-semibold text-gray-600">Карточки (<%= cards.size %>)</h2>
  <%= button_to "Сделать карточки", document_cards_path(@document),
        class: "rounded bg-gray-900 px-3 py-1.5 text-sm text-white hover:bg-gray-700" %>
</div>
<% if LlmClient.provider.name == "fake" %>
  <p class="mb-3 rounded bg-amber-50 px-3 py-2 text-xs text-amber-800">
    LLM-заглушка: ключа ANTHROPIC_API_KEY нет, карточки будут фейковыми ([stub …]).
  </p>
<% end %>
<% if cards.empty? %>
  <p class="mb-6 text-sm text-gray-500">Карточек пока нет.</p>
<% else %>
  <ol class="mb-6 space-y-3">
    <% cards.each do |card| %>
      <li id="<%= dom_id(card) %>" class="rounded border <%= card.status_valid? ? "border-gray-200" : "border-amber-300" %> bg-white px-4 py-3 text-sm">
        <div class="mb-1 flex flex-wrap gap-2 text-xs text-gray-500">
          <span><%= card.kind || "—" %></span>
          <span><%= card.difficulty || "—" %></span>
          <% unless card.status_valid? %><span class="font-semibold text-amber-700">needs_review</span><% end %>
        </div>
        <p class="font-medium"><%= card.prompt.presence || "(нет вопроса)" %></p>
        <p class="mt-1 text-gray-700"><%= card.reference_answer %></p>
        <% if card.validation_errors["errors"].present? %>
          <ul class="mt-2 list-disc pl-5 text-xs text-amber-800">
            <% card.validation_errors["errors"].each do |error| %><li><%= error %></li><% end %>
          </ul>
        <% end %>
      </li>
    <% end %>
  </ol>
<% end %>

<% chunks = @document.chunks.to_a %>
<h2 class="mb-2 text-sm font-semibold text-gray-600">Чанки (<%= chunks.size %>)</h2>
<% if chunks.empty? %>
  <p class="mb-6 text-sm text-gray-500">Чанков пока нет: документ ещё не проиндексирован.</p>
<% else %>
  <ol class="mb-6 space-y-3">
    <% chunks.each do |chunk| %>
      <li id="<%= dom_id(chunk) %>" class="rounded border border-gray-200 bg-white">
        <div class="flex justify-between gap-4 border-b border-gray-200 px-4 py-2 text-xs text-gray-600">
          <span>#<%= chunk.position %> · <%= chunk.section_ref %></span>
          <%# Only a lone code block may exceed the limit %>
          <span class="shrink-0 tabular-nums <%= "text-amber-700" if chunk.token_count > Chunker::MAX_TOKENS %>">~<%= chunk.token_count %> ток.</span>
        </div>
        <pre class="max-h-80 overflow-auto whitespace-pre-wrap p-4 text-sm"><%= chunk.content %></pre>
      </li>
    <% end %>
  </ol>
<% end %>

<%# Raw normalized Markdown on purpose: this is exactly what the Chunker sees %>
<details>
  <summary class="mb-2 cursor-pointer text-sm font-semibold text-gray-600">Текст (нормализованный Markdown)</summary>
  <pre class="max-h-[70vh] overflow-auto whitespace-pre-wrap rounded border border-gray-200 bg-white p-4 text-sm"><%= @document.body %></pre>
</details>
