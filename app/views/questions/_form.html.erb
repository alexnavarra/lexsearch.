<%= form_with model: question, class: "mb-8 space-y-3" do |f| %>
  <% if question.errors.any? %>
    <p class="rounded bg-red-50 px-3 py-2 text-sm text-red-800"><%= question.errors.full_messages.to_sentence %></p>
  <% end %>
  <%= f.text_area :text, rows: 3, required: true, placeholder: "чем HNSW отличается от IVFFlat",
        class: "w-full rounded border border-gray-300 px-3 py-2" %>
  <div class="flex flex-wrap items-center gap-3 text-sm">
    <%= f.select :topic, Document.topics, { include_blank: "любая тема" }, class: "rounded border border-gray-300 px-2 py-1" %>
    <%= f.select :kind, Document.kinds.keys, { include_blank: "любой тип" }, class: "rounded border border-gray-300 px-2 py-1" %>
    <%= f.select :language, Document.languages.keys, { include_blank: "любой язык" }, class: "rounded border border-gray-300 px-2 py-1" %>
    <%= f.submit "Спросить", class: "ml-auto rounded bg-gray-900 px-4 py-2 text-white hover:bg-gray-700" %>
  </div>
<% end %>
