<% content_for :title, "Поиск" %>

<h1 class="mb-6 text-2xl font-semibold">Поиск по смыслу</h1>

<%= form_with url: search_path, method: :get, class: "mb-6 space-y-3" do |f| %>
  <div class="flex gap-2">
    <%= f.search_field :q, value: @query, autofocus: true, placeholder: "как избежать лишних запросов при загрузке связей",
          class: "w-full rounded border border-gray-300 px-3 py-2" %>
    <%= f.submit "Найти", class: "rounded bg-gray-900 px-4 py-2 text-sm text-white hover:bg-gray-700" %>
  </div>
  <div class="flex flex-wrap gap-3 text-sm">
    <%= f.select :topic, Document.topics, { include_blank: "любая тема", selected: @filters["topic"] }, class: "rounded border border-gray-300 px-2 py-1" %>
    <%= f.select :kind, Document.kinds.keys, { include_blank: "любой тип", selected: @filters["kind"] }, class: "rounded border border-gray-300 px-2 py-1" %>
    <%= f.select :language, Document.languages.keys, { include_blank: "любой язык", selected: @filters["language"] }, class: "rounded border border-gray-300 px-2 py-1" %>
  </div>
<% end %>

<% if @query.present? && @results.empty? %>
  <p class="text-sm text-gray-500">Ничего не найдено.</p>
<% end %>

<ol class="space-y-3">
  <% @results.each_with_index do |chunk, index| %>
    <li class="rounded border border-gray-200 bg-white">
      <div class="flex justify-between gap-4 border-b border-gray-200 px-4 py-2 text-xs text-gray-600">
        <span>
          <%= index + 1 %>.
          <%= link_to chunk.section_ref, document_path(chunk.document, anchor: dom_id(chunk)), class: "text-blue-700 hover:underline" %>
        </span>
        <%# Cosine distance: 0 = same meaning; lower is better %>
        <span class="shrink-0 tabular-nums">distance <%= chunk.neighbor_distance.round(3) %></span>
      </div>
      <pre class="max-h-60 overflow-auto whitespace-pre-wrap p-4 text-sm"><%= chunk.content.truncate(1200) %></pre>
    </li>
  <% end %>
</ol>
