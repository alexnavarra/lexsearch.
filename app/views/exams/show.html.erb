<% content_for :title, "Экзамен" %>

<div class="mb-6 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-semibold">Экзамен</h1>
  <%= form_with url: exam_path, method: :get, class: "text-sm" do %>
    <%= select_tag :topic, options_for_select(Document.topics, @topic), include_blank: "все темы",
          class: "rounded border border-gray-300 px-2 py-1", onchange: "this.form.requestSubmit()" %>
  <% end %>
</div>

<dl class="mb-6 grid grid-cols-2 gap-3 text-sm sm:grid-cols-4">
  <% [ [ "К повторению сегодня", @stats[:due_today] ], [ "Новых", @stats[:new] ], [ "Проверено сегодня", @stats[:graded_today] ],
       [ "Следующий показ", @stats[:next_due_at] ? l(@stats[:next_due_at], format: :short) : "—" ] ].each do |label, value| %>
    <div class="rounded border border-gray-200 bg-white px-3 py-2">
      <dt class="text-xs text-gray-500"><%= label %></dt>
      <dd class="text-lg font-semibold"><%= value %></dd>
    </div>
  <% end %>
</dl>

<% if @card %>
  <div class="rounded border border-gray-200 bg-white px-5 py-4">
    <p class="mb-2 text-xs text-gray-500">
      <%= @card.document.topic %> · <%= @card.kind %> · <%= @card.difficulty %>
      <%= @card.due_at ? "· повторение" : "· новая" %>
      <% if @card.llm_model == LlmClient::FakeProvider::MODEL %><span class="text-amber-700">· карточка от заглушки</span><% end %>
    </p>
    <p class="mb-4 text-lg"><%= @card.prompt %></p>

    <%= form_with model: Attempt.new, url: card_attempts_path(@card), class: "space-y-3" do |f| %>
      <%= hidden_field_tag :topic, @topic %>
      <%= f.text_area :answer, rows: 6, autofocus: true, placeholder: "Ответь своими словами, как на собеседовании",
            class: "w-full rounded border border-gray-300 px-3 py-2" %>
      <div class="flex items-center gap-3">
        <%= f.submit "Проверить", class: "rounded bg-gray-900 px-4 py-2 text-sm text-white hover:bg-gray-700" %>
        <%= f.submit "Не помню", name: "skip", formnovalidate: true,
              class: "rounded border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="rounded border border-gray-200 bg-white px-4 py-3 text-sm text-gray-600">
    На сегодня всё. <% if Card.none? %>Карточек пока нет: создай их на странице материала.<% end %>
  </p>
<% end %>

<% if @scores.any? %>
  <h2 class="mb-2 mt-8 text-sm font-semibold text-gray-600">Средний балл по темам</h2>
  <table class="w-full rounded border border-gray-200 bg-white text-sm">
    <thead class="text-left text-xs text-gray-500">
      <tr><th class="px-3 py-2">Тема</th><th class="px-3 py-2">Средний балл</th><th class="px-3 py-2">Ответов</th></tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      <% @scores.each do |topic, average, count| %>
        <tr><td class="px-3 py-2"><%= topic %></td><td class="px-3 py-2"><%= average %> / 5</td><td class="px-3 py-2"><%= count %></td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>
